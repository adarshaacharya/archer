{
  "name": "@xeq/cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "xeq": "src/index.ts"
  },
  "files": ["src"],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check . --write",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@xeq/agent-core": "workspace:*",
    "@xeq/sandbox": "workspace:*",
    "@xeq/model-providers": "workspace:*",
    "@xeq/shared": "workspace:*",
    "@xeq/tui": "workspace:*"
  }
}
