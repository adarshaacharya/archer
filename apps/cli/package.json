{
  "name": "@archer/cli",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "bin": {
    "archer": "src/index.ts"
  },
  "files": ["src"],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "tsc -p tsconfig.json",
    "lint": "biome check .",
    "format": "biome check . --write",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@archer/agent-core": "workspace:*",
    "@archer/model-providers": "workspace:*",
    "@archer/sandbox": "workspace:*",
    "@archer/storage": "workspace:*",
    "@archer/shared": "workspace:*",
    "@archer/tui": "workspace:*",
    "@archer/web": "workspace:*"
  }
}
