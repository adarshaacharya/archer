{
  "name": "@adarshaacharya/archer",
  "private": true,
  "version": "0.1.3",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adarshaacharya/archer.git"
  },
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "rm -rf dist && bun build src/index.ts --target=node --format=esm --outdir dist --packages=bundle --external @opentui/core",
    "build:binary": "rm -rf dist/bin release && bun run scripts/build-binary.mjs",
    "package:binary": "bun run scripts/package-binary.mjs",
    "lint": "biome check .",
    "format": "biome check . --write",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "dependencies": {
    "@archer/agent-core": "workspace:*",
    "@archer/model-providers": "workspace:*",
    "@archer/sandbox": "workspace:*",
    "@archer/storage": "workspace:*",
    "@archer/shared": "workspace:*",
    "@archer/tui": "workspace:*",
    "@archer/web": "workspace:*"
  }
}
