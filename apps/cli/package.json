{
  "name": "@adarshaacharya/archer",
  "private": false,
  "version": "0.1.1",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adarshaacharya/archer.git"
  },
  "bin": {
    "archer": "dist/index.js"
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "bun run src/index.ts",
    "build": "rm -rf dist && bun build src/index.ts --target=node --format=esm --outdir dist --packages=bundle",
    "prepublishOnly": "bun run build",
    "lint": "biome check .",
    "format": "biome check . --write",
    "check-types": "tsc -p tsconfig.json --noEmit"
  },
  "publishConfig": {
    "access": "public"
  },
  "dependencies": {
    "@archer/agent-core": "workspace:*",
    "@archer/model-providers": "workspace:*",
    "@archer/sandbox": "workspace:*",
    "@archer/storage": "workspace:*",
    "@archer/shared": "workspace:*",
    "@archer/tui": "workspace:*",
    "@archer/web": "workspace:*"
  }
}
