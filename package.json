{
  "name": "archer",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "cli": "cd apps/cli && bun run src/index.ts",
    "evals": "bun run --filter @archer/evals evals",
    "link": "cd apps/cli && bun link",
    "bump:cli": "node scripts/bump-cli-version.mjs",
    "bump:cli:patch": "node scripts/bump-cli-version.mjs patch",
    "bump:cli:minor": "node scripts/bump-cli-version.mjs minor",
    "bump:cli:major": "node scripts/bump-cli-version.mjs major",
    "publish:cli": "cd apps/cli && bun run publish:ci",
    "fix": "bunx biome check --write .",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "check-types": "turbo run check-types"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.2.0",
    "turbo": "^2.8.21",
    "typescript": "5.9.2"
  },
  "engines": {
    "node": ">=18"
  },
  "packageManager": "bun@1.2.2",
  "workspaces": [
    "apps/*",
    "packages/*"
  ]
}
